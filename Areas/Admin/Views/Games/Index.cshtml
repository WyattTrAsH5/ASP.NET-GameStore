@model IEnumerable<ASP.NET_GameStore.Models.Game>

<h2 class="mb-4">Admin — Manage Games</h2>
<a href="/Admin/Games/Create" class="btn btn-success mb-3">Add New Game</a>

<table class="table table-hover">
    <thead>
        <tr>
            <th>Title</th>
            <th>Genre</th>
            <th>Platform</th>
            <th>Price</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var game in Model)
        {
            <tr>
                <td>@game.Title</td>
                <td>@game.Genre</td>
                <td>@game.Platform</td>
                <td>@game.Price.ToString("C")</td>
                <td>
                    <a href="/Admin/Games/Edit/@game.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a href="/Admin/Games/Delete/@game.Id" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>