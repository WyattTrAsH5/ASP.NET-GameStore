@model List<ASP.NET_GameStore.Models.CartItem>

<h2 class="mb-4">Your Cart</h2>

@if (!Model.Any())
{
    <p>Your cart is empty. <a asp-controller="Games" asp-action="Index">Browse games</a></p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th style="width: 35%">Title</th>
                <th style="width: 20%">Price</th>
                <th style="width: 15%">Quantity</th>
                <th style="width: 15%">Subtotal</th>
                <th style="width: 15%"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.Quantity</td>
                    <td>@((item.Price * item.Quantity).ToString("C"))</td>
                    <td>
                        <a href="/Cart/Remove/@item.GameId" class="btn btn-danger btn-sm">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-4 p-3" style="border-top: 2px solid #ffc107;">
        <h4>Total: @Model.Sum(i => i.Price * i.Quantity).ToString("C")</h4>
        <div>
            <a asp-controller="Games" asp-action="Index" class="btn btn-secondary me-2">Continue Shopping</a>
            <a href="#" class="btn btn-primary">Checkout</a>
        </div>
    </div>
}